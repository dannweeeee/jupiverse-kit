{
  "name": "jupiverse-kit",
  "version": "1.3.1",
  "description": "Jupiverse Kit is the ultimate ready-to-use React components library powered by Jupiter's APIs for building onchain applications on Solana effortlessly.",
  "repository": "https://github.com/dannweeeee/jupiverse-kit.git",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist/index.css",
    "dist/assets"
  ],
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "copy-assets": "cp -r src/assets dist/",
    "build": "rollup -c && tsc --emitDeclarationOnly && cp -r src/assets dist/",
    "dev": "rollup -c -w",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "clean": "rimraf dist",
    "prepare": "rimraf dist && rollup -c && tsc --emitDeclarationOnly && cp -r src/assets dist/",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "sideEffects": false,
  "keywords": [
    "solana",
    "jupiter-exchange",
    "jupiverse-kit",
    "@jup-ag/terminal",
    "@jup-ag/wallet-adapter",
    "@jup-ag/react-hook",
    "@jup-ag/api"
  ],
  "author": "Dann Wee",
  "license": "MIT",
  "dependencies": {
    "@jup-ag/api": "^6.0.40",
    "@jup-ag/jup-mobile-adapter": "^0.0.1",
    "@jup-ag/react-hook": "^6.2.0",
    "@jup-ag/terminal": "^4.0.0",
    "@jup-ag/wallet-adapter": "^0.2.2",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-solana": "^1.8.23",
    "@reown/appkit-wallet-button": "^1.8.23",
    "@solana/spl-token": "^0.4.9",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.91.3",
    "jsbi": "^4.3.0",
    "lucide-react": "^0.469.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "sonner": "^1.7.1",
    "superstruct": "^2.0.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/preset-react": "^7.23.7",
    "@babel/preset-typescript": "^7.23.7",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@rollup/plugin-url": "^8.0.2",
    "@svgr/rollup": "^8.1.0",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "rimraf": "^5.0.5",
    "rollup": "^4.29.1",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.91.3",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "bigint-buffer": "npm:four-flap-bigint-buffer@1.1.6",
      "bn.js@5": "5.2.5",
      "decode-uri-component": "0.5.0",
      "elliptic": "npm:@soatok/elliptic-to-noble",
      "lodash": "4.18.1",
      "next": "15.5.25",
      "node-fetch@2": "2.7.0",
      "postcss": "8.5.28",
      "prismjs": "1.30.0",
      "protobufjs": "7.6.6",
      "toml": "4.3.0",
      "uuid@8": "11.1.1",
      "uuid@9": "11.1.1",
      "uuid@10": "11.1.1",
      "ws@8": "8.21.3",
      "zod@3": "3.25.76"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@react-native-async-storage/async-storage",
        "react-native"
      ]
    },
    "onlyBuiltDependencies": [
      "bigint-buffer",
      "blake-hash",
      "bufferutil",
      "esbuild",
      "four-flap-bigint-buffer",
      "protobufjs",
      "sharp",
      "tiny-secp256k1",
      "unrs-resolver",
      "usb",
      "utf-8-validate"
    ],
    "ignoredBuiltDependencies": [
      "@reown/appkit",
      "@soatok/elliptic-to-noble",
      "@stellar/stellar-sdk"
    ]
  }
}
